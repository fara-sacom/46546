# ---- Core ----
PORT=8787
DATABASE_URL="file:./prisma/dev.db"
# For production, switch prisma/schema.prisma datasource provider to
# "postgresql" and set DATABASE_URL to a real Postgres connection string.

# Comma-separated API keys accepted for the FARA_STAFF_API_KEY header.
# Generate one per staff member with: npm run db:seed
STAFF_API_KEYS=

# ---- Agent brain (required for the agent to actually respond) ----
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5

# ---- Store payment info (used by the WhatsApp agent - never invented if unset) ----
# Exact text sent to a customer who chooses bank transfer. Leave empty and the
# agent will tell the customer a staff member will send the details instead
# of fabricating an account number.
STORE_BANK_TRANSFER_DETAILS=

# ---- Salla (required for all store data - products/orders/customers/reports) ----
# Create a Salla "Easy Mode" or OAuth app at https://salla.partners
SALLA_ACCESS_TOKEN=
SALLA_API_BASE_URL=https://api.salla.dev/admin/v2
SALLA_WEBHOOK_SECRET=

# ---- WhatsApp Cloud API (Meta) - required to actually send WhatsApp messages ----
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v20.0

# ---- YouTube Data API (read-only analytics) ----
YOUTUBE_API_KEY=

# ---- Meta (Instagram/Facebook) Marketing & Graph API ----
META_APP_ID=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# ---- TikTok for Business API ----
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=

# ---- Snapchat Marketing API ----
SNAPCHAT_CLIENT_ID=
SNAPCHAT_CLIENT_SECRET=
SNAPCHAT_ACCESS_TOKEN=
SNAPCHAT_AD_ACCOUNT_ID=
