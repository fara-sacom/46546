# ---- Core ----
PORT=8787
DATABASE_URL="file:./prisma/dev.db"
# For production, switch prisma/schema.prisma datasource provider to
# "postgresql" and set DATABASE_URL to a real Postgres connection string.

# Comma-separated API keys accepted for the FARA_STAFF_API_KEY header.
# Generate one per staff member with: npm run db:seed
STAFF_API_KEYS=

# ---- Agent brain (required for the agent to actually respond) ----
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5

# ---- Salla (required for all store data - products/orders/customers/reports) ----
# Create a Salla "Easy Mode" or OAuth app at https://salla.partners
SALLA_ACCESS_TOKEN=
SALLA_API_BASE_URL=https://api.salla.dev/admin/v2
SALLA_WEBHOOK_SECRET=

# ---- WhatsApp Cloud API (Meta) - required to actually send WhatsApp messages ----
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v20.0

# ---- YouTube Data API (read-only analytics) ----
YOUTUBE_API_KEY=

# ---- Meta (Instagram/Facebook) Marketing & Graph API ----
META_APP_ID=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# ---- TikTok for Business API ----
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=

# ---- Snapchat Marketing API ----
SNAPCHAT_CLIENT_ID=
SNAPCHAT_CLIENT_SECRET=
SNAPCHAT_ACCESS_TOKEN=
SNAPCHAT_AD_ACCOUNT_ID=

# ---- Optional general-purpose AI services (all free / free-tier, all optional) ----
# Tavily - web search for the agent (1,000 free searches/month, no card): https://tavily.com
TAVILY_API_KEY=

# MyMemory - translation. No key required; this is just a contact email
# (not a secret) that raises the free daily limit from ~5,000 to ~10,000
# words/day per MyMemory's own policy: https://mymemory.translated.net
MYMEMORY_CONTACT_EMAIL=

# Hugging Face Inference API - free-tier image generation for marketing
# drafts (rate limits vary, not for production volume): https://huggingface.co/settings/tokens
HUGGINGFACE_API_TOKEN=
HUGGINGFACE_IMAGE_MODEL=stabilityai/stable-diffusion-xl-base-1.0

# remove.bg - free unlimited low-res preview background removal for product
# photos (full resolution is paid): https://www.remove.bg/api
REMOVEBG_API_KEY=
